# ===== LLM (Chat Model) — Groq =====
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=llama-3.3-70b-versatile

# ===== LangSmith Tracing (Optional but recommended) =====
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your_langsmith_api_key_here
LANGSMITH_PROJECT=support-agent-lab

# ===== Billing tools (M12): MCP server. Start it with: python -m servers.billing_server =====
# Unset or unreachable => billing agent runs without tools (degraded).
BILLING_MCP_URL=http://127.0.0.1:8765/mcp

# ===== Optional: Embeddings & Vector Store (for M9) =====
# OLLAMA_EMBED_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# QDRANT_URL=https://your-qdrant-cluster.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here
# QDRANT_COLLECTION=support-docs
